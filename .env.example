# Copy this file to .env and fill in real values. Never commit .env.

# Supabase-hosted PostgreSQL connection strings.
# DATABASE_URL: pooled connection (via Supabase's connection pooler / PgBouncer) used at runtime.
# DIRECT_URL: direct connection used by Prisma for migrations and introspection.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:5432/postgres"

# APP_RUNTIME_DATABASE_URL: same pooler, but as the `app_runtime` role (created in
# prisma/migrations/20261105120000_add_rls_wioa_pii) instead of `postgres` — `postgres` has
# BYPASSRLS and owns every table, so it skips Row-Level Security entirely. src/lib/db/rls.ts uses
# this for the WIOA/PII tables RLS is scoped to. See docs/build/PHASE_1_DB_ACCESS_DECISION.md
# "Applying this migration" for how to set app_runtime's password — never commit it here.
APP_RUNTIME_DATABASE_URL="postgresql://app_runtime:[APP_RUNTIME-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"

# CRON_SECRET: shared secret for the scheduled data-retention sweep
# (.github/workflows/data-retention.yml -> src/app/api/cron/data-retention/route.ts). The cron
# call has no Supabase session, so this header is its only authentication.
CRON_SECRET="generate-a-long-random-value"

# DATA_RETENTION_MONTHS: how long after a WIOA case closes before its uploaded documents are
# destroyed (docs/build/PHASE_1_DATA_RETENTION.md). Placeholder default (36) pending sign-off —
# do not treat the default in src/lib/actions/retention.ts as the agreed policy.
DATA_RETENTION_MONTHS="36"

# Supabase project settings (placeholders for future use with Supabase client libraries).
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend (Transactional Email Infrastructure, Phase 2). RESEND_API_KEY alone is enough to send
# via Resend's shared sandbox address (no domain verification needed) — EMAIL_FROM only needs
# setting once NFCAP's own sending subdomain (e.g. mail.nfcap.org) is verified in Resend. Leave
# RESEND_API_KEY unset and src/lib/email.ts no-ops (logs a warning) instead of failing — safe for
# CI/tests and local dev before this is configured.
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="NFCAP <noreply@mail.nfcap.org>"

# Sentry (error tracking + alerting, docs/build/PERFORMANCE_PLAN.md §5.3). SENTRY_DSN and
# NEXT_PUBLIC_SENTRY_DSN are normally the same value — one DSN, read by both the server and
# client SDK init. SENTRY_AUTH_TOKEN/SENTRY_ORG/SENTRY_PROJECT are build-time only (source-map
# upload via next.config.ts's withSentryConfig) and must never be exposed to the client; leave
# all of these unset and Sentry no-ops everywhere.
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_ORG="your-sentry-org-slug"
SENTRY_PROJECT="your-sentry-project-slug"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
