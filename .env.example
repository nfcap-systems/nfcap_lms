# Copy this file to .env and fill in real values. Never commit .env.

# Supabase-hosted PostgreSQL connection strings.
# DATABASE_URL: pooled connection (via Supabase's connection pooler / PgBouncer) used at runtime.
# DIRECT_URL: direct connection used by Prisma for migrations and introspection.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:5432/postgres"

# Supabase project settings (placeholders for future use with Supabase client libraries).
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Sentry (error tracking + alerting, docs/build/PERFORMANCE_PLAN.md §5.3). SENTRY_DSN and
# NEXT_PUBLIC_SENTRY_DSN are normally the same value — one DSN, read by both the server and
# client SDK init. SENTRY_AUTH_TOKEN/SENTRY_ORG/SENTRY_PROJECT are build-time only (source-map
# upload via next.config.ts's withSentryConfig) and must never be exposed to the client; leave
# all of these unset and Sentry no-ops everywhere.
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_ORG="your-sentry-org-slug"
SENTRY_PROJECT="your-sentry-project-slug"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
